        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://app.localnord.io/api/v1/publications",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "=n8n-post-{{ $('Pick a subject').first().json.listing_id }}-{{ $now.toFormat('kkkk-WW') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ listing_id: $('Pick a subject').first().json.listing_id, subject: $('Pick a subject').first().json.subject, text: $json.data.texts[0].text, post_type: 'news', status: 'scheduled' }) }}"
      },
      "id": "a5bcae34-8e05-561f-9b60-0a9dc9b8c96c",
