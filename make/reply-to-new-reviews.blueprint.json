{
  "name": "Localnord · Reply to new Google reviews",
  "flow": [
    {
      "id": 1,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "api_key",
            "value": "lnk_PASTE_YOUR_KEY"
          }
        ],
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://app.localnord.io/api/v1/listings",
        "method": "get",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{1.api_key}}"
          }
        ],
        "qs": [],
        "parseResponse": true,
        "serializeUrl": false,
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "timeout": "",
        "followAllRedirects": false
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{2.data.data}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://app.localnord.io/api/v1/reviews/generate-reply",
        "method": "post",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{1.api_key}}"
          }
        ],
        "qs": [],
        "parseResponse": true,
        "serializeUrl": false,
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "timeout": "",
        "followAllRedirects": false,
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"listing_id\": \"{{3.id}}\", \"reply_state\": \"unreplied\", \"max_reviews\": 10, \"tone\": \"warm\"}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      },
      "filter": {
        "name": "Active listings",
        "conditions": [
          [
            {
              "a": "{{3.paused}}",
              "o": "boolean:equal",
              "b": "false"
            }
          ]
        ]
      }
    },
    {
      "id": 5,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{4.data.data.drafts}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "json:TransformToJSON",
      "version": 1,
      "parameters": {
        "space": ""
      },
      "mapper": {
        "object": "{{5.replyDraft}}"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      },
      "filter": {
        "name": "4★+ and no warning",
        "conditions": [
          [
            {
              "a": "{{5.rating}}",
              "o": "number:greaterorequal",
              "b": "4"
            },
            {
              "a": "{{length(5.validation_warnings)}}",
              "o": "number:equal",
              "b": "0"
            }
          ]
        ]
      }
    },
    {
      "id": 7,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://app.localnord.io/api/v1/reviews",
        "method": "post",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{1.api_key}}"
          },
          {
            "name": "Idempotency-Key",
            "value": "make-reply-{{5.reviewId}}"
          }
        ],
        "qs": [],
        "parseResponse": true,
        "serializeUrl": false,
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "timeout": "",
        "followAllRedirects": false,
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"review_id\": \"{{5.reviewId}}\", \"reply_text\": {{6.json}}}"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}
